{
    "name": "secret-santa-site",
    "version": "0.0.1",
    "description": "Christmas 2020 secret santa website for RND Group.",
    "main": "dist/index.js",
    "author": "jgilliland@rndgroup.com",
    "license": "MIT",
    "private": false,
    "scripts": {
        "clean": "rm -rf dist",
        "watch": "tsx watch ./src --include ./views",
        "copy-assets": "cp -r ./public/ ./dist/public/ && cp -r ./views/ ./dist/views/",
        "prestart": "npm run build",
        "start": "npm run start:prod",
        "build": "npm run clean && tsc && npm run copy-assets",
        "dev": "dotenv -e .env.development -- tsx watch ./src --include ./views --inspect",
        "start:prod": "dotenv -e .env.production -- node ./dist/index.js",
        "test": "NODE_ENV=test mocha -r --import tsx ./test/* --exit"
    },
    "dependencies": {
        "body-parser": "^1.19.0",
        "config": "^3.3.1",
        "connect-flash": "^0.1.1",
        "corepack": "^0.34.5",
        "cors": "^2.8.5",
        "dotenv": "^8.2.0",
        "dotenv-cli": "^4.0.0",
        "ejs": "^3.1.5",
        "express": "^4.17.1",
        "express-ejs-layouts": "^2.5.0",
        "express-session": "^1.17.1",
        "nodemailer": "^7.0.11",
        "pg": "^8.4.1"
    },
    "devDependencies": {
        "@types/chai": "^4.2.14",
        "@types/connect-flash": "^0.0.35",
        "@types/cors": "^2.8.7",
        "@types/express": "^4.17.8",
        "@types/express-session": "^1.17.0",
        "@types/mocha": "^8.0.3",
        "@types/sqlite3": "^3.1.8",
        "@types/supertest": "^2.0.10",
        "chai": "^4.2.0",
        "mocha": "^8.2.0",
        "shelljs": "^0.8.4",
        "sqlite3": "^5.0.0",
        "supertest": "^5.0.0",
        "tsx": "^4.21.0",
        "typescript": "^4.7.2"
    }
}
